{
  "name": "@osmosis-labs/tx",
  "version": "1.0.0",
  "main": "build/index.js",
  "author": "osmosis-labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/osmosis-labs/osmosis-frontend"
  },
  "bugs": {
    "url": "https://github.com/osmosis-labs/osmosis-frontend/issues"
  },
  "keywords": [
    "osmosis",
    "transaction"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf node_modules; rm -rf build; rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "dev": "tsc -w",
    "test": "jest --passWithNoTests",
    "lint": "oxlint src && prettier --check \"src/**/*.+(js|ts|tsx|json)\"",
    "lint:fix": "oxlint --fix src && prettier --write \"src/**/*.+(js|ts|tsx|json)\"",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@chain-registry/types": "^0.46.0",
    "@cosmjs/amino": "0.36.2",
    "@cosmjs/encoding": "0.36.2",
    "@cosmjs/math": "0.36.2",
    "@cosmjs/proto-signing": "0.36.2",
    "@cosmjs/stargate": "0.36.2",
    "@cosmos-kit/core": "^2.18.1",
    "@keplr-wallet/crypto": "0.13.41",
    "@osmosis-labs/math": "^5.1.0",
    "@osmosis-labs/proto-codecs": "^5.1.0",
    "@osmosis-labs/server": "^1.0.0",
    "@osmosis-labs/types": "^1.0.0",
    "@osmosis-labs/unit": "0.10.24-ibc.go.v7.hot.fix",
    "@osmosis-labs/utils": "^1.0.0",
    "buffer": "^6.0.3",
    "cachified": "^3.5.4",
    "cosmjs-types": "^0.10.1",
    "lru-cache": "^10.0.1",
    "utility-types": "^3.10.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.14",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*": [
      "oxlint --no-error-on-unmatched-pattern",
      "prettier --check --ignore-unknown"
    ]
  }
}
