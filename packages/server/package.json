{
  "name": "@osmosis-labs/server",
  "version": "1.0.0",
  "main": "build/index.js",
  "author": "osmosis-labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/osmosis-labs/osmosis-frontend"
  },
  "bugs": {
    "url": "https://github.com/osmosis-labs/osmosis-frontend/issues"
  },
  "keywords": [
    "osmosis",
    "server"
  ],
  "license": "Apache-2.0",
  "sideEffects": [
    "./build/utils/superjson.js",
    "./build/utils/dayjs.js"
  ],
  "scripts": {
    "clean": "rm -rf node_modules; rm -rf build; rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "dev": "tsc -w",
    "test": "jest --passWithNoTests",
    "lint": "oxlint src && prettier --check \"src/**/*.+(js|ts|tsx|json)\"",
    "lint:fix": "oxlint --fix src && prettier --write \"src/**/*.+(js|ts|tsx|json)\"",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@osmosis-labs/math": "^5.1.0",
    "@osmosis-labs/types": "^1.0.0",
    "@osmosis-labs/unit": "0.10.24-ibc.go.v7.hot.fix",
    "@osmosis-labs/utils": "^1.0.0",
    "cachified": "^3.5.4",
    "dataloader": "^2.2.3",
    "dayjs": "^1.11.23",
    "fuse.js": "^6.5.3",
    "lru-cache": "^10.0.1",
    "superjson": "^2.2.1",
    "viem": "~2.41.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/jest-in-case": "^1.0.6",
    "jest": "^30.5.2",
    "jest-in-case": "^1.0.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.14",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*": [
      "oxlint --no-error-on-unmatched-pattern",
      "prettier --check --ignore-unknown"
    ]
  }
}
