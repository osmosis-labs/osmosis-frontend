{
  "name": "@osmosis-labs/utils",
  "version": "1.0.0",
  "main": "build/index.js",
  "license": "Apache-2.0",
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf node_modules; rm -rf build; rm -f tsconfig.tsbuildinfo",
    "build": "tsc -b",
    "dev": "tsc -w",
    "test": "jest --passWithNoTests",
    "lint": "oxlint src && oxfmt --check src",
    "lint:fix": "oxlint --fix src && oxfmt src",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@cosmjs/encoding": "0.36.2",
    "@osmosis-labs/types": "^1.0.0",
    "@osmosis-labs/unit": "0.10.24-ibc.go.v7.hot.fix",
    "bitcoinjs-lib": "^7.0.4",
    "bs58": "^6.0.0",
    "bs58check": "^4.0.0",
    "ecashaddrjs": "^2.0.0",
    "ripple-address-codec": "^5.0.0",
    "viem": "~2.41.2"
  },
  "devDependencies": {
    "@types/jest-in-case": "^1.0.6",
    "fake-indexeddb": "5.0.2",
    "jest": "^30.5.2",
    "jest-in-case": "^1.0.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.90.0",
    "typescript": "6.0.3",
    "whatwg-fetch": "^3.6.2"
  },
  "lint-staged": {
    "*": [
      "oxlint --no-error-on-unmatched-pattern",
      "oxfmt --check --no-error-on-unmatched-pattern"
    ]
  }
}
