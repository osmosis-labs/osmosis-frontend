{
  "name": "@osmosis-labs/types",
  "version": "1.0.0",
  "main": "build/index.js",
  "sideEffects": false,
  "author": "osmosis-labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/osmosis-labs/osmosis-frontend"
  },
  "bugs": {
    "url": "https://github.com/osmosis-labs/osmosis-frontend/issues"
  },
  "keywords": [
    "osmosis"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf node_modules; rm -rf build; rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "dev": "tsc -w",
    "test": "jest --passWithNoTests",
    "lint": "oxlint src && prettier --check \"src/**/*\"",
    "lint:fix": "oxlint --fix src && prettier --write \"src/**/*\"",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@osmosis-labs/unit": "0.10.24-ibc.go.v7.hot.fix"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.14",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*": [
      "oxlint --no-error-on-unmatched-pattern",
      "prettier --check --ignore-unknown"
    ]
  }
}
