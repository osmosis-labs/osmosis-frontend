{
  "name": "@osmosis-labs/proto-codecs",
  "version": "5.1.0",
  "main": "build/index.js",
  "author": "osmosis-labs",
  "homepage": "https://github.com/osmosis-labs/osmosis-frontend/tree/master/packages/telescope#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/osmosis-labs/osmosis-frontend"
  },
  "bugs": {
    "url": "https://github.com/osmosis-labs/osmosis-frontend/issues"
  },
  "keywords": [
    "osmosis",
    "telescope",
    "transpiler"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf node_modules; rm -rf build; rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "oxlint src && prettier --check \"src/**/*\"",
    "lint:fix": "oxlint --fix src && prettier --write \"src/**/*\"",
    "prepublishOnly": "yarn build",
    "generate": "yarn generate:proto && yarn generate:packages && yarn generate:telescope",
    "generate:proto": "./scripts/get-proto.sh",
    "generate:packages": "tsx scripts/gen-package-types.ts",
    "generate:telescope": "tsc scripts/codegen.ts --ignoreConfig --noEmit --skipLibCheck && tsx scripts/codegen.ts && yarn lint:fix"
  },
  "lint-staged": {
    "*": [
      "oxlint --no-error-on-unmatched-pattern",
      "prettier --check --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@cosmology/proto-parser": "^1.5.0",
    "@cosmology/telescope": "^1.10.0",
    "@types/node": "^20.14.1",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@cosmjs/amino": "0.36.2",
    "@cosmjs/encoding": "0.36.2",
    "@cosmjs/proto-signing": "0.36.2",
    "@cosmjs/stargate": "0.36.2",
    "@cosmjs/tendermint-rpc": "0.36.2"
  }
}
