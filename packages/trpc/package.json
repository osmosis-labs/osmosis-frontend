{
  "name": "@osmosis-labs/trpc",
  "version": "1.0.0",
  "main": "build/index.js",
  "author": "osmosis-labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/osmosis-labs/osmosis-frontend"
  },
  "bugs": {
    "url": "https://github.com/osmosis-labs/osmosis-frontend/issues"
  },
  "keywords": [
    "osmosis",
    "tRPC"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf node_modules; rm -rf build; rm -f tsconfig.tsbuildinfo",
    "build": "tsc",
    "dev": "tsc -w",
    "test": "jest --passWithNoTests",
    "test:e2e": "yarn with-env jest --testMatch '**/__tests_e2e__/?(*.)+(spec|test).[jt]s?(x)'",
    "lint": "oxlint src && prettier --check \"src/**/*.+(js|ts|tsx|json)\"",
    "lint:fix": "oxlint --fix src && prettier --write \"src/**/*.+(js|ts|tsx|json)\"",
    "prepublishOnly": "yarn build",
    "with-env": "dotenv -e ../web/.env -c --"
  },
  "dependencies": {
    "@osmosis-labs/math": "^5.1.0",
    "@osmosis-labs/server": "^1.0.0",
    "@osmosis-labs/types": "^1.0.0",
    "@osmosis-labs/unit": "0.10.24-ibc.go.v7.hot.fix",
    "@osmosis-labs/utils": "^1.0.0",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.14",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*": [
      "oxlint --no-error-on-unmatched-pattern",
      "prettier --check --ignore-unknown"
    ]
  }
}
