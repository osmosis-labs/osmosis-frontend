{
  "name": "@osmosis-labs/web",
  "version": "5.1.0",
  "sideEffects": false,
  "private": true,
  "scripts": {
    "knip": "6.39.0",
    "predev": "yarn generate",
    "dev": "concurrently --raw --kill-others \"next dev\" \"yarn watch\"",
    "clean": "rm -rf node_modules; rm -rf .next; rm -rf config/generated",
    "build": "yarn build:packages && yarn generate && next build",
    "build:packages": "yarn --cwd ../.. turbo run build --filter=@osmosis-labs/web^...",
    "test": "yarn generate && dotenv -c -- jest --passWithNoTests",
    "analyze": "dotenv -v ANALYZE=true -- next build",
    "start": "next start",
    "cf:build": "dotenv -c production -- opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "cf:build:profile": "CF_PROFILE=true yarn cf:build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "yarn cf:build && opennextjs-cloudflare deploy -- --keep-vars",
    "cf:cache:create": "wrangler r2 bucket create osmosis-frontend-production-cache",
    "cf:router:dry-run": "wrangler deploy -c router/wrangler.jsonc --dry-run --outdir .wrangler/router",
    "cf:router:deploy": "wrangler deploy -c router/wrangler.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "prettier --check \"**/*\" && eslint .",
    "lint:fix": "prettier --write \"**/*\" && eslint . --fix",
    "pre-commit": "lint-staged",
    "generate": "yarn generate:lists && yarn generate:cosmos-kit-wallet-list && yarn generate:sprite-ids",
    "generate:lists": "dotenv -c -- tsx config/generate-lists.ts",
    "generate:cosmos-kit-wallet-list": "dotenv -c -- tsx config/generate-cosmos-kit-wallet-list.ts",
    "generate:sprite-ids": "dotenv -c -- tsx config/generate-sprite-ids.ts",
    "watch": "yarn watch:sprite-ids",
    "watch:sprite-ids": "chokidar 'public/icons/sprite.svg' -c 'yarn generate:sprite-ids'",
    "postbuild": "next-sitemap",
    "test:wallet-local-chain": "node ../../scripts/run-wallet-local-chain.mjs"
  },
  "dependencies": {
