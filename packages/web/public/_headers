/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/tokens/generated/*
  Content-Security-Policy: default-src 'none'; sandbox
  X-Content-Type-Options: nosniff

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Every TradingView bundle name carries a content hash; the loader that
# names them (charting_library.standalone.js) has none, so it is left to
# revalidate and a library upgrade is picked up on the next load.
/tradingview/bundles/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=864000
