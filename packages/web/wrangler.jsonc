{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osmosis-frontend-stage",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "osmosis-frontend-stage",
    },
    {
      // This frontend's backend: worker.ts forwards `/api/*` here. Deploy it before this Worker.
      "binding": "API",
      "service": "osmosis-frontend-api-stage",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "osmosis-frontend-stage-cache",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],
  // Cloudflare Images resizes /_next/image; without it OpenNext serves the originals.
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // Mangles identifiers on top of OpenNext's whitespace/syntax minification (~760KB gzip).
  "minify": true,
  // Avoid name-preservation helpers in production (~145 KiB gzip). Enable for readable profiles.
  "keep_names": false,
  // Per-PR Worker Previews (`wrangler preview`, .github/workflows/cf-deploy.yml). Previews
  // inherit no bindings, so each one the Worker reads from `env` is restated here.
  // Version URLs are not an option: they are not generated for Workers that export a
  // Durable Object (DOQueueHandler). Each Preview gets its own DOQueueHandler namespace.
  // Shared with stage: the R2 cache (keys are namespaced by build id), the API Worker (a
  // PR's /api changes are not in its Preview), and WORKER_SELF_REFERENCE (ISR revalidation
  // from a Preview re-renders on stage, so Preview ISR pages do not refresh).
  "previews": {
    "services": [
      {
        "binding": "WORKER_SELF_REFERENCE",
        "service": "osmosis-frontend-stage",
      },
      {
        "binding": "API",
        "service": "osmosis-frontend-api-stage",
      },
    ],
    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "osmosis-frontend-stage-cache",
      },
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "NEXT_CACHE_DO_QUEUE",
          "class_name": "DOQueueHandler",
        },
      ],
    },
    "images": {
      "binding": "IMAGES",
    },
    "observability": {
      "enabled": true,
    },
  },
  // `--env production` (master, .github/workflows/cf-deploy.yml) deploys the production pair.
  // Bindings are not inherited from the top level, so each one is restated here.
  "env": {
    "production": {
      "name": "osmosis-frontend-production",
      // Reached only through the traffic router's service binding. A public workers.dev URL
      // would forward /api/* to the production API Worker around the zone's ingress rules.
      "workers_dev": false,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "osmosis-frontend-production",
        },
        {
          "binding": "API",
          "service": "osmosis-frontend-api-production",
        },
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "osmosis-frontend-production-cache",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NEXT_CACHE_DO_QUEUE",
            "class_name": "DOQueueHandler",
          },
        ],
      },
      "images": {
        "binding": "IMAGES",
      },
    },
  },
}
