{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "config/generated/**",
        "public/tokens/generated/**",
        "tsconfig.tsbuildinfo"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "VERCEL_URL",
        "PORT",
        "GITHUB_URL",
        "CMS_REPOSITORY_PATH",
        "TWITTER_API_URL",
        "TWITTER_API_ACCESS_TOKEN",
        "KV_STORE_REST_API_URL",
        "KV_STORE_REST_API_TOKEN",
        "COINGECKO_API_KEY",
        "ASSET_LIST_COMMIT_HASH",
        "GITHUB_API_TOKEN",
        "SKIP_API_KEY"
      ]
    }
  }
}