{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  // Forwards app.osmosis.zone to the Cloudflare production Worker (worker.ts).
  "name": "osmosis-frontend-router",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "PRODUCTION",
      "service": "osmosis-frontend-production",
    },
  ],
  // Attach to app.osmosis.zone deliberately (see README), not on every deploy.
  "workers_dev": false,
  "observability": {
    "enabled": true,
  },
}
