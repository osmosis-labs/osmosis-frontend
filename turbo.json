{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [
        "build/**",
        "src/codegen/**",
        "scripts/generated/**",
        "tsconfig.tsbuildinfo"
      ],
      "dependsOn": ["^build"]
    },
    "lint": {},
    "lint:fix": {},
    "dev": {
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"]
    },
    "analyze": {}
  },
  "globalEnv": ["NODE_ENV"]
}
