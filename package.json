{
  "name": "osmosis-frontend",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "turbo dev --concurrency 15",
    "dev:testnet": "dotenv -v NEXT_PUBLIC_IS_TESTNET=true -- yarn dev",
    "start": "turbo start",
    "start:testnet": "dotenv -v NEXT_PUBLIC_IS_TESTNET=true -- yarn start",
    "build": "turbo build",
    "build:testnet": "dotenv -v NEXT_PUBLIC_IS_TESTNET=true -- yarn build",
    "build:libs": "turbo build --parallel --filter @osmosis-labs/math",
    "build:clean": "yarn clean && yarn install --immutable && yarn build",
    "clean": "turbo clean --parallel; rm -rf node_modules",
    "analyze": "turbo analyze",
    "test": "turbo test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "pre-commit": "lerna run pre-commit --concurrency 1",
    "publish:libs": "lerna publish",
    "machine-translate": "inlang machine translate -f --project ./project.inlang && yarn lint:fix",
    "lint:workspace": "sherif --ignore-package ./packages/e2e --ignore-dependency bitcoinjs-lib@^6.1.7",
    "lint:workspace:fix": "yarn lint:workspace -f",
    "postinstall": "yarn lint:workspace"
  },
  "pre-commit": [
    "pre-commit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmosis-labs/osmosis-frontend.git"
  },
  "author": "osmosis-labs",
  "bugs": {
    "url": "https://github.com/osmosis-labs/osmosis-frontend/issues"
  },
  "homepage": "https://github.com/osmosis-labs/osmosis-frontend#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@inlang/cli": "^2.11.0",
    "@next/eslint-plugin-next": "15.5.28",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "babel-jest": "^30.5.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.9.0",
    "is-ci-cli": "^2.2.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-watch-typeahead": "^3.0.1",
    "lerna": "9.0.7",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "nan": "^2.19.0",
    "node-gyp": "^10.3.1",
    "pre-commit": "^1.2.2",
    "prettier": "^3.6.2",
    "sherif": "1.13.0",
    "ts-jest": "^29.4.14",
    "turbo": "^2.11.6",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8",
  "resolutions": {
    "@walletconnect/ethereum-provider": "2.25.0",
    "@walletconnect/universal-provider": "2.25.0",
    "@babel/core": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "elliptic": "^6.6.1",
    "pbkdf2": "^3.1.7",
    "sha.js": "^2.4.12",
    "cipher-base": "^1.0.5",
    "handlebars": "^4.7.10",
    "joi": "^17.13.4",
    "@keplr-wallet/cosmos/axios": "^0.34.0",
    "@keplr-wallet/ens/axios": "^0.34.0",
    "@keplr-wallet/types/axios": "^0.34.0",
    "@terra-money/feather.js/axios": "^0.34.0",
    "@wormhole-foundation/sdk-connect/axios": "^1.20.0",
    "nx/axios": "^1.20.0",
    "nx/follow-redirects": "^1.16.1",
    "nx/smol-toml": "^1.9.0",
    "nx/brace-expansion": "^5.0.12",
    "lerna/js-yaml": "^4.3.2",
    "next/postcss": "^8.5.28",
    "@cosmology/proto-parser/minimatch": "^5.1.8",
    "@cosmology/telescope/minimatch": "^5.1.8",
    "bip32/tiny-secp256k1": "^1.1.7",
    "@ethersproject/providers/ws": "^7.5.11",
    "engine.io-client/ws": "^8.21.0",
    "viem/ws": "^8.21.0",
    "es5-ext": "npm:@unes/es5-ext@0.10.64-1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "use-sync-external-store": "^1.7.0",
    "node-fetch": "portal:./packages/web/etc/node-fetch"
  }
}
