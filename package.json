{
  "name": "osmosis-frontend",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "turbo dev --concurrency 15",
    "dev:testnet": "dotenv -v NEXT_PUBLIC_IS_TESTNET=true -- yarn dev",
    "start": "turbo start",
    "start:testnet": "dotenv -v NEXT_PUBLIC_IS_TESTNET=true -- yarn start",
    "build": "turbo build",
    "build:testnet": "dotenv -v NEXT_PUBLIC_IS_TESTNET=true -- yarn build",
    "build:clean": "yarn clean && yarn install --immutable && yarn build",
    "clean": "turbo clean --parallel; rm -rf node_modules",
    "analyze": "turbo analyze",
    "test": "turbo test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "pre-commit": "lint-staged",
    "machine-translate": "bash ./scripts/machine-translate.sh",
    "lint:workspace": "sherif --ignore-package ./packages/e2e",
    "lint:workspace:fix": "yarn lint:workspace -f",
    "postinstall": "yarn lint:workspace && yarn hooks:install",
    "hooks:install": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmosis-labs/osmosis-frontend.git"
  },
  "author": "osmosis-labs",
  "bugs": {
    "url": "https://github.com/osmosis-labs/osmosis-frontend/issues"
  },
  "homepage": "https://github.com/osmosis-labs/osmosis-frontend#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "babel-jest": "^30.5.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-watch-typeahead": "^3.0.1",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.6.2",
    "sherif": "1.13.0",
    "ts-jest": "^29.4.14",
    "turbo": "^2.11.6",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "@walletconnect/ethereum-provider": "2.25.0",
    "@walletconnect/universal-provider": "2.25.0",
    "@babel/core": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "elliptic": "^6.6.1",
    "pbkdf2": "^3.1.7",
    "sha.js": "^2.4.12",
    "cipher-base": "^1.0.5",
    "handlebars": "^4.7.10",
    "joi": "^17.13.4",
    "@keplr-wallet/cosmos/axios": "^0.34.0",
    "@keplr-wallet/ens/axios": "^0.34.0",
    "@keplr-wallet/types/axios": "^0.34.0",
    "@terra-money/feather.js/axios": "^0.34.0",
    "@wormhole-foundation/sdk-connect/axios": "^1.20.0",
    "next/postcss": "^8.5.28",
    "@cosmology/proto-parser/minimatch": "^5.1.8",
    "@cosmology/telescope/minimatch": "^5.1.8",
    "bip32/tiny-secp256k1": "^1.1.7",
    "@ethersproject/providers/ws": "^7.5.11",
    "engine.io-client/ws": "^8.21.0",
    "viem/ws": "^8.21.0",
    "es5-ext": "npm:@unes/es5-ext@0.10.64-1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "use-sync-external-store": "^1.7.0",
    "node-fetch": "portal:./packages/web/etc/node-fetch"
  }
}
